# Description: Team-based tactical shooter based on the Quake 3 Engine
# URL:         http://www.urbanterror.info/
# Depends on:  curl libsdl

name=urbanterror-bin
version=4.3.4
release=2
source="https://mirror2.urbanterror.info/UrbanTerror$(
	echo $version | tr -d . )_full.zip
	urbanterror.png
	urbanterror.desktop
	urbanterror-server.desktop
	urbanterror-launcher.sh"

build() {
	cd UrbanTerror43

	install -m 0755 -D Quake3-UrT.x86_64 \
		$PKG/opt/urbanterror/urbanterror

	install -m 0755 -D Quake3-UrT-Ded.x86_64 \
		$PKG/opt/urbanterror/urbanterror-ded

	cp -r q3ut4 $PKG/opt/urbanterror/q3ut4

	cat << EOF >> $PKG/opt/urbanterror/q3ut4/autoexec.cfg

seta cl_cURLLib "/usr/lib/libcurl.so.4"
seta r_fullscreen 0

EOF

	# freedesktop.org launchers
	install -m 0644 -Dt $PKG/usr/share/applications \
		$SRC/*.desktop

	# Pixmap
	install -m 0644 -Dt $PKG/usr/share/pixmaps \
		$SRC/urbanterror.png

	# Launcher & symlinks
	install -m 0755 -Dt $PKG/opt/urbanterror \
		$SRC/urbanterror-launcher.sh
	mkdir -p $PKG/usr/bin
	ln -s /opt/urbanterror/urbanterror-launcher.sh \
		$PKG/usr/bin/urbanterror
	ln -s /opt/urbanterror/urbanterror-launcher.sh \
		$PKG/usr/bin/urbanterror-server
}
